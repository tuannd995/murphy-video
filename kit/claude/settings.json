{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/budget-guard.sh" } ] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh" } ] },
      { "matcher": "ExitPlanMode", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/save-plan.sh" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/log-agent.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-check.sh" } ] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)", "Bash(npm run script:*)", "Bash(npm run storyboard:*)", "Bash(npm run render:*)",
      "Bash(npm run mix:*)", "Bash(npm run final:*)", "Bash(npm run make:*)", "Bash(npm run sfx:*)", "Bash(npm run lint:narration:*)",
      "Bash(npx tsx scripts/render-scene.ts:*)", "Bash(npx tsx scripts/character-sheet.ts:*)", "Bash(npx tsx scripts/sprite-demo.ts:*)",
      "Bash(ffprobe:*)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)"
    ],
    "deny": [ "Read(./.env)", "Bash(cat .env:*)" ]
  }
}
