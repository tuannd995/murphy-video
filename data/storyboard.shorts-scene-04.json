      "music": "curious",
      "captions": [
        {
          "vi": "Bài kiểm tra nhân phẩm của thời đại công nghệ: cắm USB.",
          "en": "The ultimate character test of the tech age: plugging in a USB.",
          "start": 0.6,
          "end": 4.466,
          "voice": "scene-04_00.mp3"
        },
        {
          "vi": "USB chỉ có hai mặt. Xác suất cắm đúng: năm mươi phần trăm. Dễ ợt.",
          "en": "A USB plug has two sides. Odds of getting it right: fifty percent. Easy.",
          "start": 4.716,
          "end": 11.482,
          "voice": "scene-04_01.mp3"
        },
        {
          "vi": "Lần một. Sai.",
          "en": "Try one. Wrong.",
          "start": 11.732,
          "end": 13.691,
          "voice": "scene-04_02.mp3"
        },
        {
          "vi": "Lật lại. Vẫn sai?!",
          "en": "Flip it. Still wrong?!",
          "start": 13.941,
          "end": 16.057,
          "voice": "scene-04_03.mp3"
        },
        {
          "vi": "Lật thêm lần nữa... và nó vào. Đúng y cái hướng ban đầu.",
          "en": "Flip it once more... and it goes in. Exactly the way you had it at first.",
          "start": 16.307,
          "end": 20.826,
          "voice": "scene-04_04.mp3"
        },
        {
          "vi": "Toán học nói năm mươi phần trăm. Cuộc đời nói: còn lâu nhé.",
          "en": "Math says fifty percent. Life says: nice try.",
          "start": 21.076,
          "end": 24.864,
          "voice": "scene-04_05.mp3"
        }
      ],
